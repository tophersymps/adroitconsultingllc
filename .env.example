# Adroit.io environment template — NAMES AND SHAPES ONLY. Never commit values.
#
# Local dev: copy the values from Bitwarden Secrets Manager (BWS) into .env.local
# (gitignored). Production/preview: set them on the Vercel project from BWS.
#
# The Supabase stack is decommissioned (2026-10-23). Removed:
#   NEXT_PUBLIC_SUPABASE_URL
#   NEXT_PUBLIC_SUPABASE_ANON_KEY
#   SUPABASE_SERVICE_ROLE_KEY
# Anything still holding those values should be deleted from Vercel.

# ---------------------------------------------------------------------------
# Neon Data API — the PostgREST-compatible read/write path (RLS-enforced).
# ---------------------------------------------------------------------------

# Server-side Data API base URL, INCLUDING the /rest/v1 suffix.
# e.g. https://<endpoint>.apirest.<region>.aws.neon.tech/neondb/rest/v1
NEON_DATA_API_URL=

# Same value, exposed to the browser client (src/lib/db/client.ts). It is a
# public endpoint: authorization is the caller's JWT + RLS, never a key.
NEXT_PUBLIC_NEON_DATA_API_URL=

# ---------------------------------------------------------------------------
# Managed Better Auth (Neon Auth) — session cookies + Data API JWTs.
# ---------------------------------------------------------------------------

# Auth service base URL, INCLUDING the /auth suffix.
# e.g. https://<endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth
NEON_AUTH_BASE_URL=

# >=32-char signing secret for the session-data cookie.
NEON_AUTH_COOKIE_SECRET=

# ---------------------------------------------------------------------------
# Direct Postgres connection — privileged writes ONLY (src/lib/db/service.ts:
# quiz_attempt / quiz_run / completion_events, which RLS makes server-write-only).
# Never used for reads in a request path.
# ---------------------------------------------------------------------------
# Pooled connection string (Neon serverless driver).
DATABASE_URL=
# Unpooled/direct connection (psql, migrations, scripts).
DATABASE_URL_UNPOOLED=

# Which Neon branch DATABASE_URL points at (documentation only, not read by code).
NEON_BRANCH=production

# ---------------------------------------------------------------------------
# Cloudflare R2 — audio storage (unchanged; R2 is the only audio store).
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=adroit-audio

# Audio dual-write to the retired Supabase Storage bucket — must STAY false.
AUDIO_DUAL_WRITE_SUPABASE=false
